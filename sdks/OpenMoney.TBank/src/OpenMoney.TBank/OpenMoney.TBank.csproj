<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenMoney.TBank</RootNamespace>
    <AssemblyName>OpenMoney.TBank</AssemblyName>
    <PackageId>OpenMoney.TBank</PackageId>
    <Description>Production-ready .NET client for T-Bank acquiring, E2C payouts, cards, secure deals, SBP QR, and CloudPayments receipts.</Description>
    <Authors>OpenMoney</Authors>
    <PackageTags>openmoney;tbank;tinkoff;acquiring;e2c;payments;fintech</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
